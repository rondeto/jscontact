{
    "name": "rondeto/jscontact",
    "description": "JSContact (RFC 9553) for PHP: a typed contact model with JSON reading, writing and validation, and vCard to JSContact conversion both ways (RFC 9555) that keeps what it does not understand.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Olivier Dolbeau",
            "email": "olivier@bbnt.me"
        }
    ],
    "keywords": [
        "jscontact",
        "vcard",
        "vcf",
        "contacts",
        "address book",
        "converter",
        "carddav",
        "jmap",
        "rfc6350",
        "rfc9553",
        "rfc9554",
        "rfc9555",
        "rfc9982"
    ],
    "homepage": "https://github.com/rondeto/jscontact",
    "support": {
        "issues": "https://github.com/rondeto/jscontact/issues",
        "source": "https://github.com/rondeto/jscontact"
    },
    "require": {
        "php": ">=8.4",
        "sabre/vobject": "^4.5.6 || ^5.0",
        "symfony/validator": "^7.4 || ^8.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.2",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^13.3",
        "rector/rector": "^2.6"
    },
    "suggest": {
        "myclabs/deep-copy": "To copy a Card with its nested objects"
    },
    "conflict": {
        "symfony/translation-contracts": "<2.5.3 || >=3.0,<3.4.2"
    },
    "autoload": {
        "psr-4": {
            "Rondeto\\JSContact\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rondeto\\JSContact\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
